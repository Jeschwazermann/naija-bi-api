# Copy to .env and adjust as needed. Defaults here match `docker compose up -d`
# (docker-compose.yml) so no changes are required for local dev.

NODE_ENV=development
LOGGER_LEVEL=debug

# --- Shared ---
MONGODB_URL=mongodb://localhost:27017/naija_bi
REDIS_URL=redis://localhost:6379
JWT_SECRET=local-dev-secret-change-me
CORS_ORIGIN=http://localhost:5174

# --- auth-api ---
AUTH_API_PORT=4100
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=10

# --- upload-api ---
UPLOAD_API_PORT=4000
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads-local
MAX_UPLOAD_SIZE_MB=20
# Only needed when STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- worker ---
WORKER_CONCURRENCY=5
HEALTH_PORT=8080

# --- analytics-api ---
ANALYTICS_API_PORT=4200
